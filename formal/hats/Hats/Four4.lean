def look4 (u v w : ℕ) : ℤ := (((tbl4.getD (u * 16 + v) []).getD w 0 : ℕ) : ℤ)

def four4 : Fin 4 → (Fin 4 → ℕ) → ℤ := fun i a =>
  match i with
  | 0 => look4 (a 1) (a 2) (a 3)
  | 1 => look4 (a 0) (a 2) (a 3)
  | 2 => look4 (a 0) (a 1) (a 3)
  | 3 => look4 (a 0) (a 1) (a 2)

theorem tbl4_lt : ∀ r ∈ tbl4, ∀ x ∈ r, x < 4 := by decide +kernel

theorem look4_bounds (u v w : ℕ) : 0 ≤ look4 u v w ∧ look4 u v w < 4 := by
  unfold look4
  have h : (tbl4.getD (u * 16 + v) []).getD w 0 < 4 := by
    rw [List.getD_eq_getElem?_getD (l := tbl4)]
    cases hr : tbl4[u * 16 + v]? with
    | none => simp
    | some r =>
      have hmem := tbl4_lt r (List.mem_of_getElem? hr)
      simp only [Option.getD_some]
      rw [List.getD_eq_getElem?_getD]
      cases hx : r[w]? with
      | none => simp
      | some x => simpa using hmem x (List.mem_of_getElem? hx)
  constructor
  · positivity
  · exact_mod_cast h

theorem four4_proper : ProperN 4 four4 := by
  intro i a _
  fin_cases i <;> exact look4_bounds _ _ _

theorem four4_blind : Blind four4 := by
  intro i a b h
  fin_cases i <;> simp [four4, h]

def q4 (a b c d : ℕ) : ℕ :=
  hat a (look4 b c d) * hat b (look4 a c d) * hat c (look4 a b d) * hat d (look4 a b c)

/-- The count, by the kernel: 65536 placements of the hats. -/
theorem count4 :
    (∑ a : Fin 16, ∑ b : Fin 16, ∑ c : Fin 16, ∑ d : Fin 16, q4 a b c d) = 15192 := by
  decide +kernel

theorem winsN_four4 : winsN (2 ^ 4) four4 = 15192 := by
  rw [← count4]
  show winsN 16 four4 = _
  unfold winsN termN
  rw [sum_fin4]
  refine sum_congr rfl fun x0 _ => sum_congr rfl fun x1 _ => sum_congr rfl fun x2 _ =>
    sum_congr rfl fun x3 _ => ?_
  simp [Fin.prod_univ_four, four4, q4]

/-- **Four players win at least `15191 / 64120` of the time.** -/
theorem tendsto_four4 :
    Filter.Tendsto (rateN 4 four4) Filter.atTop (nhds (15191 / 64120)) := by
  have h := tendsto_rateN four4_proper four4_blind (by norm_num : 2 ≤ 4)
  rw [limitN_eq (by norm_num : 1 ≤ 4), winsN_four4] at h
  norm_num at h
  exact h

end Hats
