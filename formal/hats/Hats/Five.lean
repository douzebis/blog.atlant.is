def look5 (u v w z : ℕ) : ℤ := (((tbl5.getD (u * 8 + v) []).getD (w * 8 + z) 0 : ℕ) : ℤ)

def five3 : Fin 5 → (Fin 5 → ℕ) → ℤ := fun i a =>
  match i with
  | 0 => look5 (a 1) (a 2) (a 3) (a 4)
  | 1 => look5 (a 0) (a 2) (a 3) (a 4)
  | 2 => look5 (a 0) (a 1) (a 3) (a 4)
  | 3 => look5 (a 0) (a 1) (a 2) (a 4)
  | 4 => look5 (a 0) (a 1) (a 2) (a 3)

theorem tbl5_lt : ∀ r ∈ tbl5, ∀ x ∈ r, x < 3 := by decide +kernel

theorem look5_bounds (u v w z : ℕ) : 0 ≤ look5 u v w z ∧ look5 u v w z < 3 := by
  unfold look5
  have h : (tbl5.getD (u * 8 + v) []).getD (w * 8 + z) 0 < 3 := by
    rw [List.getD_eq_getElem?_getD (l := tbl5)]
    cases hr : tbl5[u * 8 + v]? with
    | none => simp
    | some r =>
      have hmem := tbl5_lt r (List.mem_of_getElem? hr)
      simp only [Option.getD_some]
      rw [List.getD_eq_getElem?_getD]
      cases hx : r[w * 8 + z]? with
      | none => simp
      | some x => simpa using hmem x (List.mem_of_getElem? hx)
  constructor
  · positivity
  · exact_mod_cast h

theorem five3_proper : ProperN 3 five3 := by
  intro i a _
  fin_cases i <;> exact look5_bounds _ _ _ _

theorem five3_blind : Blind five3 := by
  intro i a b h
  fin_cases i <;> simp [five3, h]

def q5 (a b c d e : ℕ) : ℕ :=
  hat a (look5 b c d e) * hat b (look5 a c d e) * hat c (look5 a b d e)
    * hat d (look5 a b c e) * hat e (look5 a b c d)

/-- The count, by the kernel: 32768 placements of the hats. -/
theorem count5 :
    (∑ a : Fin 8, ∑ b : Fin 8, ∑ c : Fin 8, ∑ d : Fin 8, ∑ e : Fin 8, q5 a b c d e) = 5944 := by
  decide +kernel

/-- A sum over the stacks of five players, one player at a time. -/
theorem sum_fin5 (N : ℕ) (F : (Fin 5 → Fin N) → ℕ) :
    ∑ a : Fin 5 → Fin N, F a
      = ∑ x0 : Fin N, ∑ x1 : Fin N, ∑ x2 : Fin N, ∑ x3 : Fin N, ∑ x4 : Fin N,
        F ![x0, x1, x2, x3, x4] := by
  rw [sum_pi_succ]
  refine sum_congr rfl fun x0 _ => ?_
  rw [sum_fin4]
  rfl

theorem winsN_five3 : winsN (2 ^ 3) five3 = 5944 := by
  rw [← count5]
  show winsN 8 five3 = _
  unfold winsN termN
  rw [sum_fin5]
  refine sum_congr rfl fun x0 _ => sum_congr rfl fun x1 _ => sum_congr rfl fun x2 _ =>
    sum_congr rfl fun x3 _ => sum_congr rfl fun x4 _ => ?_
  simp [Fin.prod_univ_five, five3, q5]

/-- **Five players win at least `1981 / 9602` of the time.** -/
theorem tendsto_five3 :
    Filter.Tendsto (rateN 3 five3) Filter.atTop (nhds (1981 / 9602)) := by
  have h := tendsto_rateN five3_proper five3_blind (by norm_num : 2 ≤ 3)
  rw [limitN_eq (by norm_num : 1 ≤ 3), winsN_five3] at h
  norm_num at h
  exact h

/-- The bound of the paper is smaller. -/
theorem five3_gt : (205447 : ℝ) / 1012494 < 1981 / 9602 := by norm_num

end Hats
