def six : ℕ → ℕ → ℤ := fun u v => (((tbl6.getD u []).getD v 0 : ℕ) : ℤ)

theorem tbl6_lt : ∀ r ∈ tbl6, ∀ x ∈ r, x < 6 := by decide +kernel

theorem six_proper : Proper3 6 six := by
  intro u v _ _
  unfold six
  have h : (tbl6.getD u []).getD v 0 < 6 := by
    rw [List.getD_eq_getElem?_getD (l := tbl6)]
    cases hr : tbl6[u]? with
    | none => simp
    | some r =>
      have hmem := tbl6_lt r (List.mem_of_getElem? hr)
      simp only [Option.getD_some]
      rw [List.getD_eq_getElem?_getD]
      cases hx : r[v]? with
      | none => simp
      | some x => simpa using hmem x (List.mem_of_getElem? hx)
  constructor
  · positivity
  · exact_mod_cast h

/-- The count, by the kernel: 262144 placements of the hats. -/
theorem wins3_six : wins3 6 six = 73226 := by decide +kernel

/-- **Three players win at least `73225 / 261950` of the time**: the win
rates of this table reset by itself tend to that number. -/
theorem tendsto_six :
    Filter.Tendsto (rate3 6 six) Filter.atTop (nhds (73225 / 261950)) := by
  have h := tendsto_rate3 six_proper (by norm_num : 2 ≤ 6)
  unfold limit3 at h
  rw [wins3_six] at h
  have e : ((73226 : ℕ) : ℝ) - 1 = 73225 := by norm_num
  have d : (8 : ℝ) ^ 6 - (3 * 2 ^ 6 + 2) = 261950 := by norm_num
  rw [e, d] at h
  exact h

/-- The bound of the paper is smaller. -/
theorem six_gt : (9119 : ℝ) / 32670 < 73225 / 261950 := by norm_num

